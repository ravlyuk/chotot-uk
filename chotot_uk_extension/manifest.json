{
  "manifest_version": 3,
  "name": "Chợ Tốt → Українська",
  "version": "1.2.53",
  "description": "Перекладає Chợ Tốt українською: xe.chotot.com, www.chotot.com, фільтри, пошук і оголошення.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chợ Tốt українською",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.chotot.com/*",
    "https://chotot.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chotot.com/*",
        "https://chotot.com/*"
      ],
      "js": ["dictionary.js", "translator.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
